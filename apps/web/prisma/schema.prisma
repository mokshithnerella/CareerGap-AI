// Prisma Schema for CareerGap AI Intelligence Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                String          @id @default(uuid())
  email             String          @unique
  fullName          String
  careerStage       String?         // Student, Entry Level, Mid Level, Career Transition
  weeklyStudyHours  Int             @default(10)
  targetTimeline    Int             @default(12) // weeks
  learningPreference String         @default("hands_on_projects")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  resumes           Resume[]
  matchReports      MatchReport[]
  roadmaps          Roadmap[]
  bookmarks         Bookmark[]
  jobDescriptions   JobDescription[]
}

model Resume {
  id              String           @id @default(uuid())
  userId          String
  filename        String
  fileSizeBytes   Int
  pageCount       Int              @default(1)
  rawText         String
  isScanned       Boolean          @default(false)
  ocrApplied      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses        ResumeAnalysis[]
}

model ResumeAnalysis {
  id              String           @id @default(uuid())
  resumeId        String
  summary         String
  providerUsed    String           @default("deterministic_fallback")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  resume          Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  extractedSkills ExtractedSkill[]
  matchReports    MatchReport[]
}

model ExtractedSkill {
  id              String           @id @default(uuid())
  analysisId      String
  canonicalName   String
  category        String           @default("other")
  evidence        String
  evidenceType    String           @default("other")
  confidence      Float            @default(0.9)
  proficiency     String           @default("unknown")
  yearsExperience Float?
  sourcePage      Int              @default(1)
  userConfirmed   Boolean          @default(false)
  createdAt       DateTime         @default(now())

  analysis        ResumeAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model JobRole {
  id              String           @id
  title           String           @unique
  category        String
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  requirements    JobSkillRequirement[]
}

model JobSkillRequirement {
  id              String           @id @default(uuid())
  roleId          String
  canonicalName   String
  category        String           @default("other")
  isRequired      Boolean          @default(true)
  weight          Float            @default(1.0)
  description     String           @default("")
  prerequisites   String           @default("[]") // JSON string of prereqs

  role            JobRole          @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model JobDescription {
  id              String           @id @default(uuid())
  userId          String
  jobTitle        String
  companyName     String?
  rawText         String
  createdAt       DateTime         @default(now())

  user            UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MatchReport {
  id                 String         @id @default(uuid())
  userId             String
  resumeAnalysisId   String
  roleTitle          String
  overallScore       Float          // 0 to 100
  requiredCoverage   Float          // 0 to 100
  preferredCoverage  Float          // 0 to 100
  matchedCount       Int            @default(0)
  partialCount       Int            @default(0)
  missingReqCount    Int            @default(0)
  missingPrefCount   Int            @default(0)
  itemsJson          String         // Detailed JSON list of matched items & explanations
  createdAt          DateTime       @default(now())

  user               UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeAnalysis     ResumeAnalysis @relation(fields: [resumeAnalysisId], references: [id], onDelete: Cascade)
  skillGaps          SkillGap[]
  roadmaps           Roadmap[]
}

model SkillGap {
  id                 String         @id @default(uuid())
  matchReportId      String
  canonicalName      String
  category           String         @default("other")
  isRequired         Boolean        @default(true)
  importanceWeight   Float          @default(1.0)
  whyItMatters       String
  currentEvidence    String?
  recommendedTarget  String         @default("intermediate")
  suggestedAction    String
  estimatedHours     Int            @default(20)
  priorityRank       Int            @default(1)

  matchReport        MatchReport    @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
}

model LearningResource {
  id                 String         @id
  title              String
  provider           String
  skillTags          String         // Comma-separated or JSON string
  resourceType       String
  difficulty         String
  durationHours      Int
  priceCategory      String
  url                String
  verified           Boolean        @default(true)
  createdAt          DateTime       @default(now())
}

model Roadmap {
  id                 String         @id @default(uuid())
  userId             String
  matchReportId      String?
  title              String
  targetRole         String
  estimatedDurationWeeks Int        @default(12)
  weeklyHours        Int            @default(10)
  totalHours         Int            @default(120)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchReport        MatchReport?   @relation(fields: [matchReportId], references: [id], onDelete: SetNull)
  phases             RoadmapPhase[]
}

model RoadmapPhase {
  id                 String         @id @default(uuid())
  roadmapId          String
  phaseNumber        Int
  title              String
  description        String
  estimatedWeeks     Int            @default(3)

  roadmap            Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks              RoadmapTask[]
}

model RoadmapTask {
  id                 String         @id @default(uuid())
  phaseId            String
  title              String
  description        String
  targetSkill        String
  deliverable        String
  estimatedHours     Int            @default(10)
  isCompleted        Boolean        @default(false)

  phase              RoadmapPhase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id                 String         @id @default(uuid())
  userId             String
  resourceId         String
  notes              String?
  createdAt          DateTime       @default(now())

  user               UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
