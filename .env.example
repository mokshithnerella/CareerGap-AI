# CareerGap AI - Environment Variables Reference

# Database Configuration
# Local Development: SQLite
DATABASE_URL="file:./dev.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/careergap_ai?schema=public"

# Backend FastAPI Service
FASTAPI_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_FASTAPI_URL="http://127.0.0.1:8000"

# AI Provider Configuration (Optional - falls back to deterministic NLP taxonomy if empty)
AI_PROVIDER="deterministic_fallback"
# AI_PROVIDER="gemini"
# AI_API_KEY="your-gemini-or-openai-api-key"
# AI_MODEL_NAME="gemini-1.5-flash"

# Document Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB

# Authentication & Demo
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
AUTH_SECRET="your-32-character-random-secret-key"
